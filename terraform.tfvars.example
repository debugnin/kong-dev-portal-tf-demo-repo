# Copy to terraform.tfvars and fill in real values. terraform.tfvars holds
# secrets and should never be committed.

# --- Auth ---
konnect_token   = "your-konnect-personal-access-token"
konnect_api_url = "https://au.api.konghq.com"
organisation_name = "KongAir"

# --- Control Plane ---
dev_portal_cp_name     = "Dev Portal Control Plane"
dataplane_api_base_url = "http://localhost:8000"

# --- Portal ---
dev_portal_name         = "Developer Portal"
dev_portal_display_name = "Developer Portal"
dev_portal_desc_prefix  = "Developer Portal deployed for"
dev_portal_desc_suffix  = "production use-cases."

# --- Branding ---
dev_portal_logo_path      = "./dev-portal/image-assets/kong-air-logo.png"
dev_portal_logo_file_type = "png"
dev_portal_brand_color    = "#8250FF"
dev_portal_color_mode     = "light"

# --- Pages & Snippets ---
dev_portal_snippet_code_block_graphix_path        = "./dev-portal/snippets/code-block-graphix.md"
dev_portal_page_home_path                         = "./dev-portal/pages/home.md"
dev_portal_page_getting_started_path              = "./dev-portal/pages/getting-started.md"
dev_portal_page_apis_path                         = "./dev-portal/pages/apis.md"
dev_portal_page_content_home_page_hero_bg_img_url = "https://github.com/jharmn/img-bucket/blob/main/images/travel.png?raw=true"
dev_portal_page_content_home_page_hero_text_color = "#000000"
dev_portal_page_content_home_page_hero_img_width  = "55%"

# Dev Portal login is basic-auth only (no SSO/OIDC). Applications
# authenticate via a Konnect-issued API key (no external identity
# provider / DCR required) — no further variables needed for auth.
